# Public Firebase web-app configuration. Leave blank for local reference mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only. Never add NEXT_PUBLIC_ to these names.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OWNER_UID=
# Must exactly match the production origin; localhost is allowed in development.
APP_ORIGIN=http://localhost:3000
# Public scans remain disabled; requests are owner-only. Limits are work caps, not cost guarantees.
PUBLIC_REFRESH_ENABLED=false
DAILY_SEARCH_LIMIT=300
USER_COOLDOWN_MINUTES=60
MAX_PENDING_JOBS=200
