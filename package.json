{
  "name": "cebu-flight-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cebu-finder 'node --import tsx --test tests/rules.integration.ts'",
    "test:integration": "firebase emulators:exec --only firestore --project demo-cebu-finder 'node --import tsx --test tests/queue.integration.ts'",
    "worker": "node --import tsx worker/main.ts",
    "worker:discover": "node --import tsx worker/discover.ts",
    "worker:pilot": "node --import tsx worker/pilot.ts",
    "worker:pilot:chrome": "BROWSER_MODE=local-chrome node --import tsx worker/pilot.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "playwright": "1.56.1",
    "firebase-tools": "^14.0.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  }
}
