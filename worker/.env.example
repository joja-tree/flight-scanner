FIREBASE_PROJECT_ID=
PILOT_APPROVED=false
WORKER_POLL_MS=300000
SEARCH_DELAY_MS=15000
DAILY_SEARCH_LIMIT=30
# Use application-default credentials; Docker mounts a private service-account file.
# Never commit credentials. Do not give the worker an Owner role.

# Optional on a desktop computer with installed Chrome; default is headless Chromium.
# BROWSER_MODE=local-chrome
